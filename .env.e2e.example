# Copia este archivo como .env.e2e o configura las variables en el proveedor CI.
# Nunca confirmes contraseñas reales en el repositorio.
E2E_BASE_URL=http://127.0.0.1:3000

E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_PASSWORD=
E2E_PLATFORM_ADMIN_EMAIL=
E2E_PLATFORM_ADMIN_PASSWORD=
E2E_TENANT_ADMIN_EMAIL=
E2E_TENANT_ADMIN_PASSWORD=
E2E_HR_MANAGER_EMAIL=
E2E_HR_MANAGER_PASSWORD=
E2E_RECRUITER_EMAIL=
E2E_RECRUITER_PASSWORD=
E2E_INTERVIEWER_EMAIL=
E2E_INTERVIEWER_PASSWORD=
E2E_INSTRUCTOR_EMAIL=
E2E_INSTRUCTOR_PASSWORD=
E2E_SUPERVISOR_EMAIL=
E2E_SUPERVISOR_PASSWORD=
E2E_INVENTORY_MANAGER_EMAIL=
E2E_INVENTORY_MANAGER_PASSWORD=
E2E_BRANCH_USER_EMAIL=
E2E_BRANCH_USER_PASSWORD=
E2E_CANDIDATE_EMAIL=
E2E_CANDIDATE_PASSWORD=

# Integración autoritativa de onboarding. Debe apuntar al API real, no al mock.
E2E_BACKEND_API_URL=https://backend.example.com/api
E2E_REAL_BACKEND=false
E2E_CAREER_HOSTNAME=
E2E_PRIVATE_PORTAL_SLUG=marketplace
E2E_CANDIDATE_VACANCY_ID=
E2E_ALLOW_APPLICATION_MUTATION=false
E2E_ONBOARDING_MANAGER_EMAIL=
E2E_ONBOARDING_MANAGER_PASSWORD=
E2E_ONBOARDING_VIEWER_EMAIL=
E2E_ONBOARDING_VIEWER_PASSWORD=
E2E_ONBOARDING_OTHER_BRANCH_EMAIL=
E2E_ONBOARDING_OTHER_BRANCH_PASSWORD=
E2E_ONBOARDING_OTHER_TENANT_EMAIL=
E2E_ONBOARDING_OTHER_TENANT_PASSWORD=

# Fixture destructivo dedicado para candidato aprobado → incorporación.
# No reutilizar una postulación que deba conservarse sin contratar.
E2E_ONBOARDING_APPROVED_APPLICATION_ID=
E2E_ONBOARDING_APPROVED_APPLICATION_BRANCH_ID=
E2E_ONBOARDING_JOB_TITLE=Colaborador E2E
