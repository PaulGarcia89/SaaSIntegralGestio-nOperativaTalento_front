# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright-report-visual
# Las capturas de referencia SI se versionan: son la linea base del rediseno.
# (tests/visual/__screenshots__ queda deliberadamente fuera de este bloque.)

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/scripts/seed-ats-demo.mjs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.development.example
!.env.production.example
# Plantilla de variables E2E: sin ella nadie puede ejecutar la red de seguridad.
!.env.e2e.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
