{
  "name": "frontend-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:roles": "playwright test tests/e2e/role-navigation.spec.ts",
    "test:e2e:ats:staging": "playwright test --config=playwright.ats-staging.config.ts",
    "test:integration:onboarding": "playwright test --config=playwright.integration.config.ts tests/integration",
    "test:integration:restaurant": "playwright test --config=playwright.integration.config.ts tests/integration/restaurant-inventory-transactions.spec.ts",
    "test:certify:critical": "playwright test --config=playwright.critical-certification.config.ts",
    "test:a11y": "playwright test tests/e2e/public-accessibility.spec.ts",
    "test:a11y:internal": "playwright test tests/e2e/authenticated-accessibility.spec.ts",
    "audit:production": "pnpm audit --prod --audit-level critical",
    "certify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm audit:production"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "postcss": "^8.5.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
